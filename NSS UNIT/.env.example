PORT=5000
# SQLite path settings (Render persistent disk mount: /data)
SQLITE_DB_PATH=./data/nss.sqlite
# Render: set SQLITE_DB_PATH=/data/nss.sqlite

# Optional SMTP password-reset email settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=NSS UNIT PSCMR <no-reply@example.com>
